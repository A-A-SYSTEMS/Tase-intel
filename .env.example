# ============================================================
# tase-intel — Environment Configuration (EXAMPLE)
# ============================================================
# Copy this file to `.env` and fill in actual values.
# `.env` is gitignored and stays local only.
# ============================================================

# ---- PostgreSQL (TimescaleDB) ----
POSTGRES_USER=tase_intel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tase_intel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string used by Alembic and application code
# Override only if you understand the implications.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Application ----
APP_ENV=local            # local | staging | production (V1: local only)
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# ---- TimescaleDB image (pinned for reproducibility) ----
# Do NOT change to `latest` — pin per IMPLEMENTATION_GUARDRAILS.
TIMESCALEDB_IMAGE=timescale/timescaledb:2.14.2-pg15

# ---- Future: data sources (placeholders, not used in Batch 1) ----
# TASE_DATA_HUB_API_KEY=
# EODHD_API_KEY=
# FRED_API_KEY=
